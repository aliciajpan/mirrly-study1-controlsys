# Robot WebSocket Configuration
# URL of the WebSocket server on the robot machine
ROBOT_WS_URL=ws://X.X.X.X:8765

# Enable/disable robot gesture triggering
ROBOT_WS_ENABLED=true

# Debug mode: enable to see detailed robot communication logs
ROBOT_WS_DEBUG=false

# Error Handling Configuration
# If true, gesture errors won't block playback (graceful skip)
# If false, media will be skipped if gesture fails
ROBOT_GRACEFUL_SKIP=true

# Retry Configuration
# Max number of times to attempt reconnecting to robot
ROBOT_MAX_RETRIES=3

# Timeout for robot reconnection attempts (seconds)
ROBOT_RECONNECT_TIMEOUT=5

# Server Configuration
PORT=5000

# Debug mode for Flask server
DEBUG=false

# Feature Flags
# Auto-advance to next section when media ends
ENABLE_AUTO_ADVANCE=true

# Enable robot gesture triggering
ENABLE_ROBOT_GESTURES=true

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
